{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv run:*)",
      "Bash(uv tool install:*)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg:*)",
      "Bash(/opt/homebrew/opt/ffmpeg-full/bin/ffprobe:*)",
      "Bash(whisper-cli:*)",
      "Bash(yt-dlp:*)",
      "Bash(sips:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm exec remotion:*)",
      "Bash(npx remotion:*)",
      "Bash(sh scripts/install-hooks.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(ln:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
